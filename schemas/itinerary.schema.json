{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://curatour.example/schemas/itinerary.schema.json",
  "title": "Curatour planner draft itinerary v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["itinerary_id", "inquiry_id", "version", "parent_version", "created_by", "created_at", "summary", "days", "cost_summary", "assumptions", "validation_flags", "source_itineraries"],
  "properties": {
    "itinerary_id": { "$ref": "#/$defs/text" },
    "inquiry_id": { "$ref": "#/$defs/text" },
    "version": { "type": "integer", "minimum": 1 },
    "parent_version": { "type": ["integer", "null"], "minimum": 1 },
    "created_by": { "enum": ["ai", "planner"] },
    "created_at": { "type": "string", "format": "date-time" },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "destinations", "start_date", "end_date", "party", "currency"],
      "properties": {
        "title": { "$ref": "#/$defs/text" },
        "destinations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date": { "$ref": "#/$defs/date" },
        "party": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adults", "children_ages"],
          "properties": {
            "adults": { "type": "integer", "minimum": 0 },
            "children_ages": { "type": "array", "items": { "type": "integer", "minimum": 0, "maximum": 17 } }
          }
        },
        "currency": { "$ref": "#/$defs/currency" }
      }
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "date", "city", "theme", "items"],
        "properties": {
          "index": { "type": "integer", "minimum": 1 },
          "date": { "$ref": "#/$defs/date" },
          "city": { "$ref": "#/$defs/text" },
          "theme": { "$ref": "#/$defs/text" },
          "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
        }
      }
    },
    "cost_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_estimate", "by_category", "confidence"],
      "properties": {
        "total_estimate": { "$ref": "#/$defs/amount" },
        "by_category": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flights", "hotels", "activities", "transfers", "other"],
          "properties": {
            "flights": { "$ref": "#/$defs/amount" },
            "hotels": { "$ref": "#/$defs/amount" },
            "activities": { "$ref": "#/$defs/amount" },
            "transfers": { "$ref": "#/$defs/amount" },
            "other": { "$ref": "#/$defs/amount" }
          }
        },
        "confidence": { "enum": ["low", "medium", "high"] }
      }
    },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "validation_flags": {
      "description": "Computed by application code, not model assertions. Empty means unchecked.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["check", "status", "message"],
        "properties": {
          "check": { "$ref": "#/$defs/text" },
          "status": { "enum": ["pass", "warn", "fail"] },
          "message": { "$ref": "#/$defs/text" }
        }
      }
    },
    "source_itineraries": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
  },
  "allOf": [
    {
      "if": { "properties": { "version": { "const": 1 } } },
      "then": { "properties": { "parent_version": { "type": "null" } } },
      "else": { "properties": { "parent_version": { "type": "integer" } } }
    }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": { "type": ["string", "null"], "format": "date" },
    "time": { "type": ["string", "null"], "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "amount": { "type": ["number", "null"], "minimum": 0 },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "type", "title", "description", "start_time", "end_time", "location", "cost", "depends_on", "supplier_ref", "status"],
      "properties": {
        "item_id": { "$ref": "#/$defs/text" },
        "type": { "enum": ["flight", "hotel", "transfer", "activity", "meal", "free_time", "visa_task"] },
        "title": { "$ref": "#/$defs/text" },
        "description": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "start_time": { "$ref": "#/$defs/time" },
        "end_time": { "$ref": "#/$defs/time" },
        "location": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "city"],
          "properties": {
            "name": { "$ref": "#/$defs/text" },
            "city": { "$ref": "#/$defs/text" }
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["amount", "currency", "basis", "source"],
          "properties": {
            "amount": { "$ref": "#/$defs/amount" },
            "currency": { "$ref": "#/$defs/currency" },
            "basis": { "enum": ["per_person", "total"] },
            "source": { "enum": ["estimate", "quoted", "confirmed", null] }
          },
          "allOf": [
            {
              "if": { "properties": { "amount": { "type": "null" } } },
              "then": { "properties": { "source": { "type": "null" } } },
              "else": { "properties": { "source": { "enum": ["estimate", "quoted", "confirmed"] } } }
            }
          ]
        },
        "depends_on": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "supplier_ref": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
        "status": { "enum": ["proposed", "planner_edited", "confirmed"] }
      }
    }
  }
}
